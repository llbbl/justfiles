#!/usr/bin/env bash
# Fake cp: paths under /etc/apt are read and written under $STUB_ROOT instead;
# anything else goes to the real cp. Not logged: helpers and stubs copy fixtures with it.
args=()
for a; do
  case "$a" in /etc/apt/*) a="$STUB_ROOT$a" ;; esac
  args+=("$a")
done
for c in /bin/cp /usr/bin/cp; do [ -x "$c" ] && exec "$c" "${args[@]}"; done
exit 127
