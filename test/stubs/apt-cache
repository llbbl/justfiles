#!/usr/bin/env bash
# Fake apt-cache: sury, deadsnakes and NodeSource appear once their sources files exist under $STUB_ROOT.
set -euo pipefail
echo "apt-cache $*" >>"$STUB_LOG"
sury="" deadsnakes="" nodesource=""
if [ -f "$STUB_ROOT/etc/apt/sources.list.d/php.list" ]; then sury=1; fi
if [ -f "$STUB_ROOT/etc/apt/sources.list.d/deadsnakes.list" ]; then deadsnakes=1; fi
# The major NodeSource serves, from its node_N.x URL.
if [ -f "$STUB_ROOT/etc/apt/sources.list.d/nodesource.list" ]; then
  nodesource="$(sed -n 's|.*/node_\([0-9]*\)\.x .*|\1|p' "$STUB_ROOT/etc/apt/sources.list.d/nodesource.list")"
fi
case "${1:-}" in
  policy)
    echo " 500 http://deb.debian.org/debian trixie/main arm64 Packages"
    [ -z "$sury" ] || echo " 500 https://packages.sury.org/php trixie/main arm64 Packages"
    [ -z "$deadsnakes" ] || echo " 500 https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu noble/main arm64 Packages"
    [ -z "$nodesource" ] || echo " 500 https://deb.nodesource.com/node_$nodesource.x nodistro/main arm64 Packages" ;;
  search)
    case "$*" in
      *python*)
        if [ -n "$deadsnakes" ]; then sed -n 's/^ *\(python3\.[0-9]*\) .*/\1 - Python/p' "$FIXTURES/apt-madison-python.txt" | sort -u
        else echo "python3.12 - Interactive high-level object-oriented language (version 3.12)"; fi ;;
      *)
        if [ -n "$sury" ]; then cat "$FIXTURES/apt-cache-search-sury.txt"
        else echo "php8.3-cli - command-line interpreter for the PHP scripting language"; fi ;;
    esac ;;
  madison)
    shift
    if [ "$*" = nodejs ]; then
      echo "    nodejs | 20.19.2+dfsg-1+deb13u3 | http://deb.debian.org/debian trixie/main arm64 Packages"
      [ -z "$nodesource" ] || echo "    nodejs | $nodesource.4.1-1nodesource1 | https://deb.nodesource.com/node_$nodesource.x nodistro/main arm64 Packages"
      exit 0
    fi
    for p; do grep "^ *$p |" "$FIXTURES/apt-madison-python.txt"; done ;;
  *) echo "fake apt-cache: unhandled: $*" >&2; exit 2 ;;
esac
