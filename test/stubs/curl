#!/usr/bin/env bash
# Fake curl: serves fixtures by URL, never touches the network.
set -euo pipefail
echo "curl $*" >>"$STUB_LOG"
for url; do :; done
# STUB_CURL_FAIL fails every URL; STUB_CURL_MISSING fails only that one.
if [ -n "${STUB_CURL_FAIL:-}" ] || [ "$url" = "${STUB_CURL_MISSING:-}" ]; then
  echo "curl: (22) The requested URL returned error: 404" >&2
  exit 22
fi
case "$url" in
  https://endoflife.date/api/php.json) cat "$FIXTURES/eol-php.json" ;;
  https://endoflife.date/api/python.json) cat "$FIXTURES/eol-python.json" ;;
  https://endoflife.date/api/nodejs.json) cat "$FIXTURES/eol-nodejs.json" ;;
  https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key) echo "fake nodesource key" ;;
  https://deb.nodesource.com/node_*.x/dists/nodistro/Release | https://ppa.launchpadcontent.net/*/Release) echo "fake Release" ;;
  https://keyserver.ubuntu.com/*) echo "fake deadsnakes key" ;;
  https://packages.sury.org/debsuryorg-archive-keyring.deb) echo "fake keyring deb" ;;
  *) echo "fake curl: no fixture for $url" >&2; exit 22 ;;
esac
