#!/usr/bin/env bash
# Fake apt-get. STUB_APT_UPDATE_FAIL=<text> fails `update` while any
# sources.list.d/*.list contains <text> (a repo name, or node_22.x).
echo "apt-get $*" >>"$STUB_LOG"
text="${STUB_APT_UPDATE_FAIL:-}"
if [ "${1:-}" = update ] && [ -n "$text" ] && cat "$STUB_ROOT"/etc/apt/sources.list.d/*.list 2>/dev/null | grep -Fq -- "$text"; then
  echo "E: The repository for '$text' does not have a Release file." >&2
  exit 100
fi
