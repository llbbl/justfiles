#!/usr/bin/env bash
# Fake apt-get. STUB_APT_UPDATE_FAIL fails `update` once a deadsnakes sources file exists.
echo "apt-get $*" >>"$STUB_LOG"
if [ "${1:-}" = update ] && [ -n "${STUB_APT_UPDATE_FAIL:-}" ] && [ -f "$STUB_ROOT/etc/apt/sources.list.d/deadsnakes.list" ]; then
  echo "E: The repository 'deadsnakes' does not have a Release file." >&2
  exit 100
fi
