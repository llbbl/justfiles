#!/usr/bin/env bash
# Fake apt-get. STUB_APT_UPDATE_FAIL=<name> fails `update` once
# sources.list.d/<name>.list exists.
echo "apt-get $*" >>"$STUB_LOG"
list="${STUB_APT_UPDATE_FAIL:-}"
if [ "${1:-}" = update ] && [ -n "$list" ] && [ -f "$STUB_ROOT/etc/apt/sources.list.d/$list.list" ]; then
  echo "E: The repository '$list' does not have a Release file." >&2
  exit 100
fi
